// VibeBoot's own icons, on the VibeWare 16-unit grid (1-unit strokes, 0/45/90 degrees,
// axis-aligned strokes on half units). The shared set lives in @vibeware.

export global AppIcons {
    // Full scan (admin): a shield, its point at 45 degrees.
    out property <string> shield: "M 3.5 2.5 L 13.5 2.5 L 13.5 9.5 L 8.5 14.5 L 3.5 9.5 Z M 8.5 5 L 8.5 11";
    // Journal: a page of lines.
    out property <string> journal: "M 3.5 1.5 L 13.5 1.5 L 13.5 14.5 L 3.5 14.5 Z M 6 5.5 L 11 5.5 M 6 8.5 L 11 8.5 M 6 11.5 L 9 11.5";
    // Save report: a sheet with the download arrow.
    out property <string> save: "M 3.5 1.5 L 9.5 1.5 L 12.5 4.5 L 12.5 14.5 L 3.5 14.5 Z M 8.5 6 L 8.5 12 M 6 9.5 L 8.5 12 L 11 9.5";
    // Undo: an arrow back, its bend at 45 degrees.
    out property <string> undo: "M 5.5 4 L 2.5 7 L 5.5 10 M 2.5 7 L 11.5 7 L 13.5 9 L 13.5 11 L 11.5 13 L 8 13";
    // Portable: a stick.
    out property <string> stick: "M 5.5 6.5 L 11.5 6.5 L 11.5 14.5 L 5.5 14.5 Z M 6.5 6.5 L 6.5 2.5 L 10.5 2.5 L 10.5 6.5 M 7.5 4 L 7.5 4.5 M 9.5 4 L 9.5 4.5";
}
